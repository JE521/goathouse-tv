<?xml version="1.0" encoding="utf-8"?>
<!-- goathouse: the focused row lifts a little, like tvOS. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.03" android:duration="140" android:valueType="floatType" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.03" android:duration="140" android:valueType="floatType" />
            <objectAnimator android:propertyName="translationZ" android:valueTo="12dp" android:duration="140" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1" android:duration="140" android:valueType="floatType" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1" android:duration="140" android:valueType="floatType" />
            <objectAnimator android:propertyName="translationZ" android:valueTo="0dp" android:duration="140" android:valueType="floatType" />
        </set>
    </item>
</selector>
